{
  "name": "tasks-and-notes",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests tools *.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:content": "node tools/check-content.mjs",
    "check:source": "node tools/check-source.mjs",
    "check:duplication": "jscpd src --threshold 3 --min-lines 6 --reporters console",
    "test:e2e": "playwright test",
    "icons": "node tools/icons.mjs",
    "inventory": "node tools/inventory.mjs",
    "check:build": "node tools/check-build.mjs",
    "package": "npm run build && npm run inventory && npm run check:build && node tools/checksums.mjs"
  },
  "dependencies": {
    "dexie": "4.4.7",
    "lucide-react": "0.378.0",
    "react": "18.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.6",
    "@types/react": "18.3.31",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-sonarjs": "4.2.2",
    "fake-indexeddb": "6.2.7",
    "happy-dom": "21.0.4",
    "jscpd": "5.4.2",
    "prettier": "3.9.10",
    "sharp": "0.35.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.6",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": ">=22.23.4 <23 || >=24.0.0"
  },
  "overrides": {
    "minimatch": "11.0.5",
    "glob": "14.0.4"
  }
}
